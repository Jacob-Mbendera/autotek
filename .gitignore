# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.local
.env.*.local
**/.env

# Build outputs
dist/
build/
**/dist/
**/build/

# Compiled output committed alongside its own .ts source is a resolution hazard:
# Node's require() prefers a sibling .js over the .ts source under ts-node, so an
# edit to the .ts file is silently invisible at runtime until the .js is rebuilt
# or removed. shared/types and backend/src/types/shared are TS-source-only.
shared/types/*.js
shared/types/*.js.map
shared/types/*.d.ts
shared/types/*.d.ts.map
backend/src/types/shared/*.js
backend/src/types/shared/*.js.map
backend/src/types/shared/*.d.ts
backend/src/types/shared/*.d.ts.map

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# Package manager locks (optional - some teams commit these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ========================================
# AutoTek Backend Environment Variables
# ========================================
# SECURITY: Never commit the actual .env file to version control
# Copy this file to .env and replace all placeholder values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Get your connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret - CRITICAL SECURITY
# Generate a strong secret with: openssl rand -base64 64
# NEVER use a weak password or default value
# This secret is used to sign authentication tokens
JWT_SECRET=<REPLACE_WITH_OUTPUT_FROM_openssl_rand_-base64_64>

# Airtel Money API (Malawi)
# Register at: https://developers.airtel.africa
AIRTEL_API_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=<your-airtel-client-id>
AIRTEL_CLIENT_SECRET=<your-airtel-client-secret>

# Cloudinary Configuration
# Register at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# PayChangu Payment Gateway (Malawi)
# Register at: https://paychangu.com
# Development: Use test keys (pub-test-... and sec-test-...)
# Production: Use live keys (pub-live-... and sec-live-...)
PAYCHANGU_API_KEY=<pub-test-... or pub-live-...>
PAYCHANGU_API_SECRET=<sec-test-... or sec-live-...>
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_WEBHOOK_SECRET=<same-as-api-secret>

# Bank Transfer payment method — merchant account details shown to buyers at checkout
BANK_TRANSFER_BANK_NAME=<e.g. National Bank of Malawi>
BANK_TRANSFER_ACCOUNT_NAME=<e.g. AutoTek Ltd>
BANK_TRANSFER_ACCOUNT_NUMBER=<account number>
BANK_TRANSFER_BRANCH=<e.g. Blantyre Branch>

FRONTEND_URL=http://localhost:5173
# Optional: comma-separated allowlist of extra CORS origins (e.g. staging + prod).
# When unset, only FRONTEND_URL is allowed.
# CORS_ALLOWED_ORIGINS=https://autotek.example.com,https://staging.autotek.example.com

# Stale unpaid order cleanup (BR-13) — releases stock held by abandoned checkouts
STALE_UNPAID_ORDER_HOURS=48
# Optional soak-test override (takes precedence over HOURS when set, e.g. 10)
# STALE_UNPAID_ORDER_MINUTES=10
STALE_ORDER_CLEANUP_INTERVAL_MS=3600000
STALE_ORDER_CLEANUP_ENABLED=true

# Email Configuration
# Choose one option and configure accordingly

# Option 1: SendGrid (Recommended for production)
# Register at: https://sendgrid.com
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=<your-sendgrid-api-key>
# EMAIL_FROM=AutoTek <noreply@autotek.mw>

# Option 2: Gmail SMTP (For development/testing)
# Create app password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASS=<your-gmail-app-password>
EMAIL_FROM=AutoTek <your-email@gmail.com>

# Option 3: Custom SMTP Server
# EMAIL_HOST=<your-smtp-server>
# EMAIL_PORT=587
# EMAIL_USER=<smtp-username>
# EMAIL_PASS=<smtp-password>
# EMAIL_FROM=AutoTek <noreply@autotek.mw>

# Geocoding Service (Optional)
# Option 1: Google Maps Geocoding API (most accurate)
# Get API key at: https://console.cloud.google.com/apis/credentials
# GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>
# Option 2: Leave empty to use free OpenStreetMap Nominatim (default)
GOOGLE_MAPS_API_KEY=

# ========================================
# SECURITY CHECKLIST BEFORE PRODUCTION:
# ========================================
# ✅ Generate strong JWT_SECRET (openssl rand -base64 64)
# ✅ Use production MongoDB URI (not development)
# ✅ Switch PayChangu to live keys (pub-live-... and sec-live-...)
# ✅ Configure production email service (SendGrid recommended)
# ✅ Set NODE_ENV=production
# ✅ Update FRONTEND_URL to production domain
# ✅ Enable Cloudinary secure URLs
# ✅ Never expose .env file in version control
# ✅ Rotate all secrets if any have been exposed
# ✅ Set up environment variables in hosting platform

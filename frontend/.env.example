# Frontend Environment Variables Example
# Copy this file to .env and update with your values
# Vite requires VITE_ prefix for environment variables

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Frontend Base URL (for PayChangu return/cancel URLs)
VITE_BASE_URL=http://localhost:5173

# Production values (comment out for development)
# VITE_API_URL=https://api.autotek.mw/api
# VITE_BASE_URL=https://autotek.mw
